@model IEnumerable<Clínica_Veterinaria.Models.Mascota>
@{
    ViewData["Title"] = "Lista de Mascotas";
}
<h1>Lista de Mascotas</h1>

<p>
    <a class="btn btn-primary" href="@Url.Action("Registrar", "Mascota")">Registrar nueva mascota</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay mascotas registradas.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Especie</th>
                <th>Raza</th>
                <th>Edad</th>
                <th>Dueño</th>
                <th>Teléfono</th>
                <th>Fecha Ingreso</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Nombre</td>
                    <td>@m.Especie</td>
                    <td>@m.Raza</td>
                    <td>@m.Edad</td>
                    <td>@m.Nombre_Dueño</td>
                    <td>@m.Telefono_Dueño</td>
                    <td>@m.Fecha_Ingreso.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}
